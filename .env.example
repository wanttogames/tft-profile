RIOT_API_KEY=
# Optional CommunityDragon version: latest or a supported major.minor
TFT_STATIC_VERSION=latest
# Server-only Collector credentials (GitHub Actions repository secrets)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PLAYERS_LIMIT=2
MATCHES_PER_PLAYER=2
RIOT_REQUEST_DELAY_MS=1400
# Netlify meta API minimum sample count (also configure the two Supabase env vars above)
MIN_SAMPLE_SIZE=10
